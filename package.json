    "scripts": {
        "wasm:dev": "wasm-pack build crate --dev --out-dir pkg --out-name shell",
        "wasm:release": "wasm-pack build crate --release --out-dir pkg --out-name shell",
        "start": "pnpm run wasm:dev && vite",
        "dev": "pnpm run wasm:dev && vite",
        "build:debug": "pnpm run wasm:dev && vite build --outDir build/debug --minify false --sourcemap",
        "build:release": "pnpm run wasm:release && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src types --max-warnings=0"
    },
    "engines": {
        "node": ">=20"
    },
