{
    "compilerOptions": {
        "outDir": "./build/ts/",
        "target": "es5",
        "module": "es2020",
        "moduleResolution": "node",
        "sourceMap": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "downlevelIteration": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"],
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["es6", "es2020", "dom", "webworker"],
    },
    "exclude": ["./test/**/*.ts", "./node_modules"],
    "include": ["./src/**/*", "./types/*.d.ts"]
}
